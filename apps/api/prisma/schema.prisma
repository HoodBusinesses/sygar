generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  phone               String
  cnss                Int           @unique
  firstName           String
  lastName            String
  password            String?
  passwordChangedAt   DateTime?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  role                Role
  type                UserType
  identityType        IdentityType
  identity            String
  isActive            Boolean       @default(false)
  abilities           Ability[]
  organization        Organization? @relation(fields: [organizationId], references: [id])
  organizationId      String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  address   String
  cnss      String    @unique
  ice       String    @unique
  imageLink String    @default("")
  users     User[] // Relation to Users
  Ability   Ability[]

  // reminders Reminder[]
  themes Theme[] // Relation to Groups

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  Group     Group[]
}

model Ability {
  id             String        @id @default(uuid()) // Primary key
  userId         String // Scalar foreign key for User
  user           User          @relation(fields: [userId], references: [id]) // Relation to User
  action         String
  code           Int
  organizationId String? // Nullable foreign key for Organization
  organization   Organization? @relation(fields: [organizationId], references: [id]) // Proper relation to Organization
}

model Group {
  id           String        @id @default(uuid())
  themeId      String
  theme        Theme         @relation(fields: [themeId], references: [id])
  trainerName  String
  animatorName String
  address      String
  organization Organization  @relation(fields: [organizationId], references: [id]) // Relation to Organization
  dates        GroupDate[] // Relation to GroupDate
  participants Participant[] // Relation to Participants
  // feedbacks    Feedback[] // Group feedback
  // attendances  GroupAttendance[] // Attendance relation

  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  organizationId String
}

model GroupDate {
  id      String   @id @default(uuid())
  groupId String
  group   Group    @relation(fields: [groupId], references: [id])
  date    DateTime
  // attendances GroupAttendance[] // Relation to Attendance

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Participant {
  id           String            @id @default(uuid())
  firstName    String
  lastName     String
  phone        String
  email        String
  cnss         String
  identityType IdentityType
  identity     String
  status       ParticipantStatus
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id]) // feedbacks    Feedback[]
  // attendances  GroupAttendance[] // Attendance relation

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


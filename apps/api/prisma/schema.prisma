model Theme {
  id     String  @id @default(uuid())
  name   String
  price  Decimal
  year   Int
  groups Group[]

  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

enum UserType {
  ORGANIZATION_USER
  SOLUTION_OWNER
}

enum ParticipantStatus {
  Employer
}

enum IdentityType {
  CIN
  Passport
  Permit
}

enum Role {
  Owner
  Admin
  User
}
